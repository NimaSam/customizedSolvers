FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/water";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 -3 0 0 0 0 ];

internalField   uniform 0.1;

boundaryField
{
    maxY
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    minX
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    maxX
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    minZ
    {
        type            empty;
        value           uniform 0.1;
    }
    maxZ
    {
        type            empty;
        value           uniform 0.1;
    }
    water_to_heater
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }
}


